{
  "name": "mootmaker-release",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Smoke-test suites for the mootmaker release pipeline. See ../mootmaker/designs/ci-cd-pipeline.md Decision 9.",
  "scripts": {
    "smoke:test": "playwright test -c smoke/playwright.config.ts --project=test-stage",
