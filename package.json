{
  "name": "mootmaker-release",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Smoke-test suites for the mootmaker release pipeline. See ../mootmaker/designs/archive/ci-cd-pipeline.md Decision 9.",
  "scripts": {
    "smoke:test": "playwright test -c smoke/playwright.config.ts --project=test-stage",
    "smoke:production": "playwright test -c smoke/playwright.config.ts --project=production-stage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "mootmaker-email-testing": "github:geoffweatherall/mootmaker-email-testing#v1.0.0"
  }
}
